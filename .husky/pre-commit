#!/bin/sh

# Full validation (typecheck+tests+build) runs on merge/push only, for commit speed.
# Secret scanning is the exception: it must run on every commit, on staged content only,
# so a credential never enters git history in the first place.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "⚠️  gitleaks not installed, skipping secret scan (install: https://github.com/gitleaks/gitleaks)"
    exit 0
fi

echo "🔒 Scanning staged changes for secrets..."
if ! gitleaks git --staged --redact; then
    echo "❌ Secret scan found a potential leak in staged changes — commit blocked"
    exit 1
fi
echo "✅ No secrets found in staged changes"
