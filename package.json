{
  "name": "mx-security-dark-sim",
  "version": "2.1.0",
  "description": "Interactive dark-mode simulator for analyzing homicide trends in Mexico with what-if scenarios",
  "keywords": [
    "mexico",
    "data-science",
    "simulation",
    "dark-mode",
    "typescript",
    "react",
    "vite",
    "recharts"
  ],
  "author": "Kuautli <cuauhtemocbe@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite",
    "start:dev": "vite --open",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules .pnpm-store",
    "validate": "./scripts/validate.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "3.8.1",
    "vite": "^6.4.2",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.0.5",
    "autoprefixer": "10.5.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.1.6",
    "postcss": "8.5.13",
    "tailwindcss": "3.4.19",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bash -c 'cd /app && pnpm run typecheck'",
      "bash -c 'cd /app && pnpm run build'"
    ]
  }
}
