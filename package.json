{
  "name": "mx-security-dark-sim",
  "version": "2.1.0",
  "description": "Interactive dark-mode simulator for analyzing homicide trends in Mexico with what-if scenarios",
  "keywords": [
    "mexico",
    "data-science",
    "simulation",
    "dark-mode",
    "typescript",
    "react",
    "vite",
    "recharts"
  ],
  "author": "Kuautli <cuauhtemocbe@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.html",
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
  "scripts": {
    "dev": "vite",
    "start:dev": "vite --open",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules .pnpm-store",
    "validate": "./scripts/validate.sh",
    "prepare": "husky || true"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.2",
    "vite": "^6.4.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.0.5",
    "autoprefixer": "10.5.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.1.6",
    "postcss": "8.5.17",
    "tailwindcss": "3.4.19",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bash -c 'cd /app && pnpm run typecheck'",
      "bash -c 'cd /app && pnpm run build'"
    ]
  }
}
