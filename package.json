{
  "name": "mx-security-dark-sim",
  "version": "2.1.0",
  "description": "Interactive dark-mode simulator for analyzing homicide trends in Mexico with what-if scenarios",
  "keywords": [
    "mexico",
    "data-science",
    "simulation",
    "dark-mode",
    "typescript",
    "react",
    "vite",
    "recharts"
  ],
  "author": "Kuautli <cuauhtemocbe@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.html",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "dev": "vite",
    "start:dev": "vite --open",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "biome check .",
    "format:check": "biome format .",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules .pnpm-store",
    "validate": "./scripts/validate.sh",
    "prepare": "husky || true"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "vite": "^8.2.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.1.6",
    "postcss": "8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bash -c 'cd /app && pnpm run typecheck'",
      "bash -c 'cd /app && pnpm run build'"
    ]
  }
}
